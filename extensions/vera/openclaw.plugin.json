{
  "id": "vera",
  "categories": ["research"],
  "activation": {
    "onStartup": true
  },
  "name": "Vera",
  "description": "Plans a lawyer's morning WhatsApp digest and calls Lexroom research and drafting.",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accessToken": {
        "type": "string"
      },
      "baseUrl": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000
      },
      "googleClientId": {
        "type": "string"
      },
      "googleClientSecret": {
        "type": "string"
      },
      "googleRedirectUri": {
        "type": "string"
      },
      "googleStateSecret": {
        "type": "string"
      }
    }
  },
  "contracts": {
    "tools": [
      "vera_plan_digest",
      "vera_research",
      "vera_draft",
      "vera_google_connect",
      "vera_read_inbox",
      "vera_read_calendar"
    ]
  },
  "toolMetadata": {
    "vera_plan_digest": {
      "optional": true
    },
    "vera_research": {
      "optional": true
    },
    "vera_draft": {
      "optional": true
    },
    "vera_google_connect": {
      "optional": true
    },
    "vera_read_inbox": {
      "optional": true
    },
    "vera_read_calendar": {
      "optional": true
    }
  }
}
