{
  "id": "vera",
  "categories": ["research"],
  "activation": {
    "onStartup": true
  },
  "name": "Vera",
  "description": "Lawyer WhatsApp digest with Instinct-shaped matter memory and event-driven wakes.",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accessToken": {
        "type": "string"
      },
      "baseUrl": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000
      },
      "googleClientId": {
        "type": "string"
      },
      "googleClientSecret": {
        "type": "string"
      },
      "googleRedirectUri": {
        "type": "string"
      },
      "googleStateSecret": {
        "type": "string"
      },
      "googlePubSubTopic": {
        "type": "string"
      },
      "googleNotifyToken": {
        "type": "string"
      }
    }
  },
  "contracts": {
    "tools": [
      "vera_plan_digest",
      "vera_research",
      "vera_draft",
      "vera_google_connect",
      "vera_read_inbox",
      "vera_read_calendar",
      "vera_send_email",
      "vera_memory_search",
      "vera_memory_list",
      "vera_memory_get",
      "vera_memory_history",
      "vera_todo_list",
      "vera_todo_get"
    ]
  },
  "toolMetadata": {
    "vera_plan_digest": {
      "optional": true
    },
    "vera_research": {
      "optional": true
    },
    "vera_draft": {
      "optional": true
    },
    "vera_google_connect": {
      "optional": true
    },
    "vera_read_inbox": {
      "optional": true
    },
    "vera_read_calendar": {
      "optional": true
    },
    "vera_send_email": {
      "optional": true
    },
    "vera_memory_search": {
      "optional": true
    },
    "vera_memory_list": {
      "optional": true
    },
    "vera_memory_get": {
      "optional": true
    },
    "vera_memory_history": {
      "optional": true
    },
    "vera_todo_list": {
      "optional": true
    },
    "vera_todo_get": {
      "optional": true
    }
  }
}
