{
  "id": "ada",
  "categories": ["research"],
  "activation": {
    "onStartup": true
  },
  "name": "Ada",
  "description": "Lawyer WhatsApp digest with Instinct-shaped matter memory and event-driven wakes.",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accessToken": {
        "type": "string"
      },
      "baseUrl": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000
      },
      "idleTimeoutMs": {
        "type": "integer",
        "minimum": 1000
      },
      "answerTimeoutMs": {
        "type": "integer",
        "minimum": 1000
      },
      "researchModules": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "googleClientId": {
        "type": "string"
      },
      "googleClientSecret": {
        "type": "string"
      },
      "googleRedirectUri": {
        "type": "string"
      },
      "googleStateSecret": {
        "type": "string"
      },
      "googlePubSubTopic": {
        "type": "string"
      },
      "googleNotifyToken": {
        "type": "string"
      },
      "statusToken": {
        "type": "string"
      },
      "googleNotifyAudience": {
        "type": "string"
      },
      "googleNotifyIssuer": {
        "type": "string"
      },
      "googleNotifyServiceAccount": {
        "type": "string"
      },
      "lexroomConnectUri": {
        "type": "string"
      },
      "lexroomStateSecret": {
        "type": "string"
      },
      "deadlineIntake": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "reminders": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(\\d{1,3}d|morning-of)$"
            }
          },
          "horizonDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "minConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "digestReadyTemplate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "language"],
        "properties": {
          "name": { "type": "string" },
          "language": { "type": "string" }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "ada_plan_digest",
      "ada_research",
      "ada_research_status",
      "ada_draft",
      "ada_lexroom_connect",
      "ada_google_connect",
      "ada_read_inbox",
      "ada_read_calendar",
      "ada_send_email",
      "ada_create_calendar_event",
      "ada_update_calendar_event",
      "ada_deadline_list",
      "ada_deadline_reply",
      "ada_memory_search",
      "ada_memory_list",
      "ada_memory_get",
      "ada_memory_history",
      "ada_todo_list",
      "ada_todo_get"
    ]
  },
  "toolMetadata": {
    "ada_plan_digest": {
      "optional": true
    },
    "ada_research": {
      "optional": true
    },
    "ada_research_status": {
      "optional": true
    },
    "ada_draft": {
      "optional": true
    },
    "ada_lexroom_connect": {
      "optional": true
    },
    "ada_google_connect": {
      "optional": true
    },
    "ada_read_inbox": {
      "optional": true
    },
    "ada_read_calendar": {
      "optional": true
    },
    "ada_send_email": {
      "optional": true
    },
    "ada_create_calendar_event": {
      "optional": true
    },
    "ada_update_calendar_event": {
      "optional": true
    },
    "ada_deadline_list": {
      "optional": true
    },
    "ada_deadline_reply": {
      "optional": true
    },
    "ada_memory_search": {
      "optional": true
    },
    "ada_memory_list": {
      "optional": true
    },
    "ada_memory_get": {
      "optional": true
    },
    "ada_memory_history": {
      "optional": true
    },
    "ada_todo_list": {
      "optional": true
    },
    "ada_todo_get": {
      "optional": true
    }
  }
}
